MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=5000
CORS_ORIGINS=http://localhost:5173
# Optional image uploads; credentials are only used on the backend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, only used when running npm run seed
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-password-of-at-least-10-characters
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-password-of-at-least-16-characters
